generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum GymStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  nickname            String?              @unique
  avatarUrl           String?
  bio                 String?
  height              Float?
  passwordHash        String
  role                Role                 @default(USER)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  notifications       Notification[]
  gyms                Gym[]
  gymCheckIns         GymCheckIn[]
  gymReviews          GymReview[]
  gymEquipmentReviews GymEquipmentReview[]
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // gym_approved | gym_rejected
  actorId    String?
  targetType String? // gym
  targetId   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read])
}

model Gym {
  id            String         @id @default(cuid())
  name          String
  address       String
  city          String
  district      String?
  lat           Float
  lng           Float
  description   String?
  environment   String?
  price         String?
  hours         String?
  phone         String?
  images        String[]
  status        GymStatus      @default(PENDING)
  submittedById String
  submittedBy   User           @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  equipment     GymEquipment[]
  checkIns      GymCheckIn[]
  reviews       GymReview[]

  @@index([city, district])
  @@index([status])
}

model GymEquipment {
  id               String               @id @default(cuid())
  gymId            String
  gym              Gym                  @relation(fields: [gymId], references: [id], onDelete: Cascade)
  name             String
  professionalName String?
  serialLabel      String?
  quantity         Int                  @default(1)
  status           String               @default("NORMAL")
  reviews          GymEquipmentReview[]
}

model GymEquipmentReview {
  id          String       @id @default(cuid())
  equipmentId String
  equipment   GymEquipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating      Int
  comment     String?
  createdAt   DateTime     @default(now())

  @@unique([equipmentId, userId])
}

model GymCheckIn {
  id        String   @id @default(cuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      String // YYYY-MM-DD
  createdAt DateTime @default(now())

  @@unique([gymId, userId, date])
}

model GymReview {
  id        String   @id @default(cuid())
  gymId     String
  gym       Gym      @relation(fields: [gymId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([gymId, userId])
}
