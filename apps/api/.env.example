# PostgreSQL 连接串（把 <你的密码> 换成 postgres 用户的密码）
DATABASE_URL="postgresql://postgres:<你的密码>@localhost:5432/gym_map"

# 必填：至少 32 位随机密钥，空值及示例值会阻止启动。
# 生成命令：node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# 服务端端口
PORT=3000
HOST=127.0.0.1

# 默认只支持同源请求；需要独立前端域名时填写完整 Origin，多个用逗号分隔。
CORS_ORIGINS=""

# 仅当 API 绑定回环地址，且由可信本机反向代理转发时设置 loopback。
# 代理必须覆盖 X-Forwarded-For 为真实客户端 IP，不能接受客户端伪造的值。
TRUST_PROXY=""

# 默认使用 API 工作目录下的 uploads；可设置为持久化目录的绝对路径。
# UPLOAD_DIR="/var/lib/gym-map/uploads"
